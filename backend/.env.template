APP_ENV=development
APP_PORT=3001
# Local dev runs Nest on the host (`npm run dev`) and Postgres in docker, so
# the DB is reached via localhost on the published port. tomo uses 5433 so it
# can run alongside denwa-alert's Postgres on 5432.
TEST_DB_HOST=localhost
TEST_DB_PORT=5433
DB_HOST=localhost
DB_PORT=5433
DB_NAME=tomo_gym
DB_USER=root
DB_PASS=example
JWT_ACCESS_TOKEN_EXP_IN_SEC=3600
JWT_REFRESH_TOKEN_EXP_IN_SEC=7200
# Generate with ./scripts/generate-jwt-keys (RS256 keypair, base64-encoded).
JWT_PUBLIC_KEY_BASE64=
JWT_PRIVATE_KEY_BASE64=
DEFAULT_ADMIN_USER_PASSWORD=admin-example

# Model provider for the chat agent. 'stub' = deterministic stand-in, no API
# key needed (refused when APP_ENV=production).
LLM_PROVIDER=stub
LLM_MODEL=claude-haiku-5-5
# Where the agent reaches tomo's own MCP server (defaults to localhost:APP_PORT).
# MCP_INTERNAL_URL=http://localhost:3001/api/v1/mcp

# Signup gate (roadmap Step 6). All optional; the values shown are defaults.
# SIGNUP_MODE=open              # 'closed' rejects signups (default in production until Step 6b)
# CHAT_RATE_PER_MINUTE=15       # per user
# CHAT_RATE_PER_DAY=200
# MCP_RATE_PER_MINUTE=60        # per personal access token
# MCP_RATE_PER_DAY=2000
# LOGIN_RATE_PER_MINUTE=10      # per IP
# SIGNUP_RATE_PER_HOUR=10       # per IP
# USER_DAILY_BUDGET_USD=0.05    # the user's local calendar day
# USER_MONTHLY_BUDGET_USD=1
# GLOBAL_DAILY_BUDGET_USD=5     # all users together (UTC day); chat pauses past it
