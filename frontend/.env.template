# Base URL of the backend: scheme + host (+ port), no trailing slash. The
# generated client's paths already start with /api/v1.
#
# Leave unset in local dev: requests then go to the Vite dev server on :5174,
# which proxies /api to the backend on :3001 (see vite.config.ts).
# Production sets it at build time (Step 9).
# VITE_API_BASE_URL=
